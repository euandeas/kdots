// Kansora's default fastfetch config, installed to /etc/xdg/fastfetch/config.jsonc.
// Override it per user with ~/.config/fastfetch/config.jsonc
// (`fastfetch --gen-config` writes a full one to start from).
// Colours are terminal palette names, so they follow your DMS/Flexoki theme.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  // The Kansora K
  "logo": {
    "type": "data",
    "source": "$1███       ▄███\n███    ▄███▀\n███  ▄██▀\n███ ███\n███ ███\n███  ▀██▄\n███    ▀███▄\n███       ▀███",
    "color": { "1": "blue" },
    "padding": { "top": 1, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "blue", "title": "blue" },
    // Values start at this column, so keys must be shorter (hence "WM", "Font")
    "key": { "width": 12 }
  },
  "modules": [
    "break",
    "title",
    "separator",
    "os",
    {
      "type": "command",
      "key": "Kansora",
      "text": "rpm -q --qf '%{VERSION}, build %{RELEASE}' kansora 2>/dev/null | sed -E 's/\\.git([0-9a-f]+)\\.fc[0-9]+$/ (\\1)/' || echo 'not installed'"
    },
    "kernel",
    "uptime",
    "packages",
    "shell",
    { "type": "wm", "key": "WM" },
    {
      "type": "command",
      "key": "Shell UI",
      "text": "printf 'DMS %s' \"$(rpm -q --qf '%{VERSION}' dms 2>/dev/null)\""
    },
    "terminal",
    { "type": "terminalfont", "key": "Font" },
    "cpu",
    "gpu",
    "memory",
    { "type": "disk", "key": "Disk", "folders": "/" },
    { "type": "battery", "key": "Battery" },
    "break",
    "colors"
  ]
}
